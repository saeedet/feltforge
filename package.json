{
  "name": "feltforge-workspace",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @feltforge/playground dev",
    "build:playground": "pnpm --filter @feltforge/playground build --base=/feltforge/",
    "build": "turbo run build && node tooling/package/build.mjs",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare:assets": "node tooling/assets/build.mjs && node tooling/assets/modules.mjs",
    "generate:ranks": "node tooling/assets/ranks.mjs",
    "generate:tables": "node tooling/assets/tables.mjs",
    "test:visual": "node tooling/assets/verify.mjs",
    "package:check": "node tooling/package/verify.mjs && node tooling/package/pack.mjs",
    "package:pack": "node tooling/package/pack.mjs --pack",
    "test:consumers": "node tooling/package/consumers.mjs",
    "package:release": "pnpm build && node tooling/package/build.mjs --release && pnpm package:check && pnpm package:pack"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "opentype.js": "2.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "svgo": "4.1.0",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
