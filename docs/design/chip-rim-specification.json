  "notes": [
    {
      "id": "26c05812-20d7-8042-8008-c68a5ce0e7ea",
      "text": "Chip ├ Outer Edge ├ Edge Inserts ├ Rim ├ Inner Ring ├ Center Field └ Label"
    },
    {
      "id": "dcb052a4-ae96-8045-8008-cae9e2095d06",
      "text": "Chip rim — before / after · AFTER approved as the primary design"
    },
    {
      "id": "dcb052a4-ae96-8045-8008-cae9e216c85a",
      "text": "Before: the 1 px rim stroke sat on Outer Edge, UNDER the Edge Inserts, so light inserts hid it and the silhouette looked dented. After: the rim is its own ring ABOVE the inserts — continuous on every chip."
    },
    {
      "id": "af8256be-c88d-80ed-8008-ca6147067e67",
      "text": "0 2 0 · 45% (hard rim = chip thickness)  +  0 4 8 · 25%"
    },
    {
      "id": "dcb052a4-ae96-8045-8008-caea2fbe3a4b",
      "text": "3× ZOOM (1 px rim → 3 px)"
    },
    {
      "id": "dcb052a4-ae96-8045-8008-cae9e22e2774",
      "text": "AFTER — PRIMARY DESIGN ✓ (approved)"
    }
