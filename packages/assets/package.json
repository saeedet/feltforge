{
  "name": "@feltforge/assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@feltforge/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./symbols": {
      "types": "./dist/generated/symbols.d.ts",
      "import": "./dist/generated/symbols.js"
    },
    "./classic": {
      "types": "./dist/generated/classic.d.ts",
      "import": "./dist/generated/classic.js"
    },
    "./courts/persian": {
      "types": "./dist/generated/courts/persian.d.ts",
      "import": "./dist/generated/courts/persian.js"
    },
    "./courts/western": {
      "types": "./dist/generated/courts/western.d.ts",
      "import": "./dist/generated/courts/western.js"
    },
    "./courts/eastern": {
      "types": "./dist/generated/courts/eastern.d.ts",
      "import": "./dist/generated/courts/eastern.js"
    },
    "./jokers/1": {
      "types": "./dist/generated/jokers/1.d.ts",
      "import": "./dist/generated/jokers/1.js"
    },
    "./jokers/2": {
      "types": "./dist/generated/jokers/2.d.ts",
      "import": "./dist/generated/jokers/2.js"
    },
    "./compact-ranks": {
      "types": "./dist/generated/compact-ranks.d.ts",
      "import": "./dist/generated/compact-ranks.js"
    }
  }
}
